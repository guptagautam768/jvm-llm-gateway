# Copy to .env for docker compose. Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Local Ollama. Compose points this at the ollama service. No key is required.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=

# Caller key bootstrapped into Postgres as key_id + SHA-256(secret). Not a provider key.
# Presented to the gateway as:  Authorization: Bearer lgw_<GATEWAY_BOOTSTRAP_KEY_ID>_<GATEWAY_BOOTSTRAP_KEY_SECRET>
# Generate one with:
#   python -c "import os,base64; print(os.urandom(4).hex()); print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
GATEWAY_BOOTSTRAP_TENANT_ID=local
GATEWAY_BOOTSTRAP_KEY_ID=
GATEWAY_BOOTSTRAP_KEY_SECRET=
GATEWAY_RATE_CAPACITY=60
GATEWAY_RATE_REFILL_PER_SECOND=1
# Leave blank for no budget. Zero is a hard cap.
GATEWAY_TOKEN_BUDGET=
GATEWAY_COST_BUDGET_MICROS=
GATEWAY_TOKENS_PER_MINUTE=
GATEWAY_BUDGET_WINDOW=30d
